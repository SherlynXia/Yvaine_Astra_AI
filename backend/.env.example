# DeepSeek API Key (用于 LLM 对话)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选: 其他 LLM 配置
# OPENAI_API_KEY=your_openai_key
# QWEN_API_KEY=your_qwen_key

# ===== 火山引擎 SeedTTS 2.0（语音合成 V3 API）=====
# 从 https://console.volcengine.com/speech/ 获取
VOLCANO_APPID=7972466877
VOLCANO_TOKEN=QA80hu0NALITMQZ5UdNqOcnZzk9Vf8SI

# TTS 调用模式:
# - websocket: WebSocket 单向流式 (推荐，延迟更低，支持连接复用)
# - http: HTTP 单向流式 (备用方案)
TTS_MODE=websocket

# 音色 (voice_type):
# - 系统音色: zh_female_wanwanxiaohe_moon_bigtts 等
# - 克隆音色: ICL_xxx (从声音复刻页面复制)
# - 2.0 新音色: BV700_V2_streaming, BV705_streaming, S_xxx 等
# 音色列表见: https://www.volcengine.com/docs/6561/1257584
VOLCANO_VOICE_TYPE=S_Fc16SKDd2

# 资源 ID (resource_id) - 一般不需要手动设置，程序会自动推断
# - 系统音色: volcano_tts
# - Seed-TTS 2.0: seed-tts-2.0
# - 克隆音色: seed-icl-2.0
# 只有自动推断不正确时才需要手动填写
# VOLCANO_RESOURCE_ID=seed-icl-2.0

# 模型类型 (model_type) - 仅复刻音色需要设置
# 根据音色训练版本选择:
# - 1: ICL 1.0
# - 2: DiT 标准版
# - 3: DiT 还原版
# - 4: ICL 2.0 (默认)
# - 5: ICL 3.0
# VOLCANO_MODEL_TYPE=4

# 情感控制 (emotion) - 仅部分 2.0 音色支持
# 可选值: happy, sad, angry, fearful, disgusted, surprised, neutral
# 留空则不指定情感
# VOLCANO_EMOTION=happy